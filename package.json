{
	"name": "@sigrea/use",
	"version": "0.2.1",
	"description": "Framework-agnostic Sigrea utilities for signals, scopes, and browser APIs.",
	"keywords": [
		"browser",
		"dom",
		"reactivity",
		"scope",
		"signals",
		"typescript",
		"utilities"
	],
	"homepage": "https://github.com/sigrea/use#readme",
	"bugs": {
		"url": "https://github.com/sigrea/use/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sigrea/use.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "vp pack",
		"smoke": "node --input-type=module -e \"const mod = await import('@sigrea/use'); if (typeof mod.createEvents !== 'function') throw new Error('createEvents export is missing');\" && node -e \"const mod = require('@sigrea/use'); if (typeof mod.createEvents !== 'function') throw new Error('createEvents export is missing');\"",
		"cicheck": "vp check && vp test run && vp pack && vp run smoke",
		"prepare": "vp config --no-agent",
		"notes": "vp exec changelogen --no-output",
		"release_version": "node scripts/release.js prepare",
		"push_release": "node scripts/release.js push"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@sigrea/core": "^0.7.0",
		"@vitest/coverage-v8": "catalog:",
		"changelogen": "^0.6.2",
		"jsdom": "^24.1.3",
		"semver": "^7.7.3",
		"typescript": "5.9.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sigrea/core": "^0.7.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1"
}
